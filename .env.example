# Copy to apps/api/.env and apps/web/.env.local

# --- API (apps/api/.env) ---
MONGODB_URI=mongodb://127.0.0.1:27017/saas
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
PORT=4000
STRIPE_WEBHOOK_SECRET=whsec_mock_local_dev_only

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
