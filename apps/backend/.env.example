NODE_ENV=development
LOG_LEVEL=info
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/saas
JWT_ACCESS_SECRET=replace-with-32-char-secret-minimum
JWT_REFRESH_SECRET=replace-with-32-char-secret-minimum
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
# Comma-separated; include both localhost and 127.0.0.1 if you switch hosts/ports during dev
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
STRIPE_WEBHOOK_SECRET=whsec_mock_local_dev_only
