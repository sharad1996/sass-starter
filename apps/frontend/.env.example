# Same-origin API proxy (recommended for local dev): leave NEXT_PUBLIC_API_URL unset or empty.
# Next.js forwards /api/v1/* to the Express server so refresh cookies work on localhost vs 127.0.0.1.
INTERNAL_API_URL=http://127.0.0.1:4000

# Optional: bypass proxy and call the API directly (can break cookies if UI host ≠ API cookie host).
# NEXT_PUBLIC_API_URL=http://localhost:4000
